  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.1: Define Specialized Retrieval Agents"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class RetrievalAgent:\n",
    "    \"\"\"\n",
    "    Base class for specialized retrieval agents.\n",
    "    Each agent focuses on a specific document type or domain.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, agent_id: str, agent_name: str, domains: List[str], index: HybridIndex):\n",
    "        self.agent_id = agent_id\n",
    "        self.agent_name = agent_name\n",
    "        self.domains = domains  # Domains this agent specializes in\n",
    "        self.index = index\n",
    "        self.confidence_threshold = 0.5\n",
    "        self.retrieval_history = []\n",
    "        \n",
    "    def retrieve(self, query: str, k: int = 5) -> List[Dict[str, Any]]:\n",
    "        \"\"\"\n",
    "        Retrieve relevant documents for the query.\n",
    "        Returns: List of (chunk, score, metadata) tuples\n",
    "        \"\"\"\n",
    "        results = self.index.search(query, k=k)\n",
    "        \n",
    "        retrieved_evidence = []\n",
    "        for chunk, score in results:\n",
    "            evidence = {\n",
    "                'agent_id': self.agent_id,\n",
    "                'agent_name': self.agent_name,\n",
    "                'chunk_id': chunk.chunk_id,\n",
    "                'content': chunk.content,\n",
    "                'score': float(score),\n",
    "                'confidence': min(score * 1.2, 1.0),  # Confidence score\n",
    "                'metadata': chunk.metadata.to_dict() if chunk.metadata else {},\n",
    "                'retrieval_timestamp': datetime.now().isoformat()\n",
    "            }\n",
    "            retrieved_evidence.append(evidence)\n",
    "        \n",
    "        self.retrieval_history.append({\n",
    "            'query': query,\n",
    "            'results_count': len(retrieved_evidence),\n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        })\n",
    "        \n",
    "        return retrieved_evidence\n",
    "\n",
    "class PolicyRetrievalAgent(RetrievalAgent):\n",
    "    \"\"\"Specializes in retrieving policy and compliance documents.\"\"\"\n",
    "    def __init__(self, index: HybridIndex):\n",
    "        super().__init__(\n",
    "            agent_id='policy_agent_001',\n",
    "            agent_name='Policy Retrieval Agent',\n",
    "            domains=['compliance', 'policy', 'governance', 'risk'],\n",
    "            index=index\n",
    "        )\n",
    "\n",
    "class TechnicalDocumentationAgent(RetrievalAgent):\n",
    "    \"\"\"Specializes in technical documentation and architecture.\"\"\"\n",
    "    def __init__(self, index: HybridIndex):\n",
    "        super().__init__(\n",
    "            agent_id='tech_agent_001',\n",
    "            agent_name='Technical Documentation Agent',\n",
    "            domains=['architecture', 'design', 'implementation', 'technical'],\n",
    "            index=index\n",
    "        )\n",
    "\n",
    "class IncidentAnalysisAgent(RetrievalAgent):\n",
    "    \"\"\"Specializes in incident reports and operational issues.\"\"\"\n",
    "    def __init__(self, index: HybridIndex):\n",
    "        super().__init__(\n",
    "            agent_id='incident_agent_001',\n",
    "            agent_name='Incident Analysis Agent',\n",
    "            domains=['incident', 'outage', 'issue', 'problem', 'resolution'],\n",
    "            index=index\n",
    "        )\n",
    "\n",
    "class ComplianceAgent(RetrievalAgent):\n",
    "    \"\"\"Specializes in compliance and security documents.\"\"\"\n",
    "    def __init__(self, index: HybridIndex):\n",
    "        super().__init__(\n",
    "            agent_id='compliance_agent_001',\n",
    "            agent_name='Compliance Agent',\n",
    "            domains=['security', 'privacy', 'encryption', 'audit', 'gdpr'],\n",
    "            index=index\n",
    "        )\n",
    "\n",
    "class FAQAgent(RetrievalAgent):\n",
    "    \"\"\"Specializes in frequently asked questions.\"\"\"\n",
    "    def __init__(self, index: HybridIndex):\n",
    "        super().__init__(\n",
    "            agent_id='faq_agent_001',\n",
    "            agent_name='FAQ Agent',\n",
    "            domains=['faq', 'help', 'support', 'common', 'question'],\n",
    "            index=index\n",
    "        )\n",
    "\n",
    "print(\"✓ Specialized Retrieval Agents defined\")"
   ]
  }
