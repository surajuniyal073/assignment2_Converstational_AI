    "# TASK 1: Enterprise Knowledge Processing and Index Construction\n",
    "## Marks: 2\n",
    "\n",
    "### Objective\n",
    "Design a scalable document ingestion and indexing pipeline for heterogeneous enterprise knowledge sources.\n",
    "\n",
    "### Components:\n",
    "1. Document Processing (PDF, Word, Email, Spreadsheet, HTML, Images)\n",
    "2. Text Cleaning and Normalization\n",
    "3. Duplicate Detection\n",
    "4. Language Detection\n",
    "5. Version Management\n",
    "6. Multiple Indexing Strategies\n",
    "7. Metadata Schema"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.1: Define Document Schema and Metadata Structure"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from enum import Enum\n",
    "from dataclasses import dataclass, field\n",
    "from typing import List, Dict, Optional\n",
    "from datetime import datetime\n",
    "\n",
    "class ConfidentialityLevel(Enum):\n",
    "    \"\"\"Document confidentiality classification\"\"\"\n",
    "    PUBLIC = \"PUBLIC\"\n",
    "    INTERNAL = \"INTERNAL\"\n",
    "    CONFIDENTIAL = \"CONFIDENTIAL\"\n",
    "    SECRET = \"SECRET\"\n",
    "\n",
    "class DocumentType(Enum):\n",
    "    \"\"\"Types of enterprise documents\"\"\"\n",
    "    PDF = \"PDF\"\n",
    "    WORD = \"WORD\"\n",
    "    EMAIL = \"EMAIL\"\n",
    "    SPREADSHEET = \"SPREADSHEET\"\n",
    "    HTML = \"HTML\"\n",
    "    IMAGE = \"IMAGE\"\n",
    "    TEXT = \"TEXT\"\n",
    "\n",
    "@dataclass\n",
    "class DocumentMetadata:\n",
    "    \"\"\"Comprehensive metadata schema for enterprise documents\"\"\"\n",
    "    doc_id: str  # Unique identifier\n",
    "    filename: str\n",
    "    doc_type: DocumentType\n",
    "    department: str\n",
    "    confidentiality_level: ConfidentialityLevel\n",
    "    author: str\n",
    "    version: str\n",
    "    created_date: datetime\n",
    "    modified_date: datetime\n",
    "    timestamp: datetime\n",
    "    document_relationships: List[str] = field(default_factory=list)  # Related doc IDs\n",
    "    keywords: List[str] = field(default_factory=list)\n",
    "    business_process: str = \"\"\n",
    "    language: str = \"en\"\n",
    "    file_size_bytes: int = 0\n",
    "    content_hash: str = \"\"  # For duplicate detection\n",
    "    \n",
    "    def to_dict(self) -> Dict:\n",
    "        \"\"\"Convert metadata to dictionary\"\"\"\n",
    "        data = asdict(self)\n",
    "        data['doc_type'] = self.doc_type.value\n",
    "        data['confidentiality_level'] = self.confidentiality_level.value\n",
    "        data['created_date'] = self.created_date.isoformat()\n",
    "        data['modified_date'] = self.modified_date.isoformat()\n",
    "        data['timestamp'] = self.timestamp.isoformat()\n",
    "        return data\n",
    "\n",
    "@dataclass\n",
    "class DocumentChunk:\n",
    "    \"\"\"Represents a chunked segment of a document\"\"\"\n",
    "    chunk_id: str\n",
    "    doc_id: str\n",
    "    parent_chunk_id: Optional[str]  # For hierarchical relationships\n",
    "    child_chunk_ids: List[str] = field(default_factory=list)\n",
    "    content: str = \"\"\n",
    "    content_length: int = 0\n",
    "    chunk_index: int = 0\n",
    "    metadata: Optional[DocumentMetadata] = None\n",
    "    \n",
    "print(\"✓ Document schema and metadata structure defined\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1.2: Document Processing Pipeline"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "from typing import Tuple\n",
    "import hashlib\n",
    "\n",
    "class DocumentProcessor:\n",
    "    \"\"\"\n",
    "    Handles ingestion and processing of heterogeneous document sources.\n",
    "    Supports: PDF, Word, Email, Spreadsheet, HTML, Images\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.processed_docs = []\n",
    "        self.duplicate_hashes = set()\n",
    "        \n",
    "    def compute_content_hash(self, content: str) -> str:\n",
    "        \"\"\"Compute SHA-256 hash of content for duplicate detection\"\"\"\n",
    "        return hashlib.sha256(content.encode()).hexdigest()\n",
    "    \n",
    "    def normalize_text(self, text: str) -> str:\n",
    "        \"\"\"\n",
    "        Text normalization:\n",
    "        - Remove extra whitespace\n",
    "        - Standardize line breaks\n",
    "        - Remove control characters\n",
    "        \"\"\"\n",
    "        # Remove control characters\n",
    "        text = ''.join(ch for ch in text if ord(ch) >= 32 or ch in '\\n\\r\\t')\n",
    "        # Normalize whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text)\n",
    "        # Remove leading/trailing whitespace\n",
    "        text = text.strip()\n",
    "        return text\n",
    "    \n",
    "    def clean_text(self, text: str) -> str:\n",
    "        \"\"\"\n",
    "        Advanced text cleaning:\n",
    "        - Remove URLs\n",
    "        - Remove email addresses\n",
    "        - Standardize punctuation\n",
    "        \"\"\"\n",
    "        # Remove URLs\n",
    "        text = re.sub(r'http\\S+|www\\S+', '', text)\n",
    "        # Remove email addresses\n",
    "        text = re.sub(r'\\S+@\\S+', '', text)\n",
    "        # Normalize punctuation\n",
    "        text = re.sub(r'\\s+\\.', '.', text)\n",
    "        text = re.sub(r'\\s+,', ',', text)\n",
    "        return text.strip()\n",
    "    \n",
    "    def detect_language(self, text: str) -> str:\n",
    "        \"\"\"\n",
    "        Simple language detection based on common words.\n",
    "        For production, use 'langdetect' or 'textblob'\n",
    "        \"\"\"\n",
    "        text_lower = text.lower()\n",
    "        english_words = ['the', 'is', 'and', 'to', 'of', 'a', 'in', 'for']\n",
    "        if sum(1 for word in english_words if word in text_lower) > 2:\n",
    "            return 'en'\n",
    "        return 'unknown'\n",
    "    \n",
    "    def detect_duplicates(self, content: str) -> Tuple[bool, str]:\n",
    "        \"\"\"\n",
    "        Detect duplicate documents using content hash.\n",
    "        Returns: (is_duplicate, content_hash)\n",
    "        \"\"\"\n",
    "        content_hash = self.compute_content_hash(content)\n",
    "        is_duplicate = content_hash in self.duplicate_hashes\n",
    "        if not is_duplicate:\n",
    "            self.duplicate_hashes.add(content_hash)\n",
    "        return is_duplicate, content_hash\n",
    "    \n",
    "    def chunk_text(self, text: str, chunk_size: int = 512, overlap: int = 100) -> List[str]:\n",
    "        \"\"\"\n",
    "        Split text into overlapping chunks for indexing.\n",
    "        Args:\n",
    "            text: Input text\n",
    "            chunk_size: Size of each chunk in characters\n",
    "            overlap: Overlap between consecutive chunks\n",
    "        \"\"\"\n",
    "        chunks = []\n",
    "        sentences = text.split('. ')\n",
    "        current_chunk = \"\"\n",
    "        \n",
    "        for sentence in sentences:\n",
    "            if len(current_chunk) + len(sentence) < chunk_size:\n",
    "                current_chunk += sentence + \". \"\n",
    "            else:\n",
    "                if current_chunk:\n",
    "                    chunks.append(current_chunk.strip())\n",
    "                current_chunk = sentence + \". \"\n",
    "        \n",
    "        if current_chunk:\n",
    "            chunks.append(current_chunk.strip())\n",
    "        \n",
    "        return chunks\n",
    "    \n",
    "    def process_document(self, filename: str, content: str, metadata: Dict) -> List[DocumentChunk]:\n",
    "        \"\"\"\n",
    "        Main document processing pipeline.\n",
    "        \"\"\"\n",
    "        # Step 1: Normalize text\n",
    "        content = self.normalize_text(content)\n",
    "        \n",
    "        # Step 2: Clean text\n",
    "        content = self.clean_text(content)\n",
    "        \n",
    "        # Step 3: Detect language\n",
    "        language = self.detect_language(content)\n",
    "        \n",
    "        # Step 4: Check for duplicates\n",
    "        is_duplicate, content_hash = self.detect_duplicates(content)\n",
    "        if is_duplicate:\n",
    "            print(f\"⚠ Duplicate detected: {filename}\")\n",
    "            return []\n",
    "        \n",
    "        # Step 5: Create document metadata\n",
    "        doc_id = str(uuid.uuid4())\n",
    "        doc_metadata = DocumentMetadata(\n",
    "            doc_id=doc_id,\n",
    "            filename=filename,\n",
    "            doc_type=DocumentType[metadata.get('doc_type', 'TEXT')],\n",
    "            department=metadata.get('department', 'Unknown'),\n",
    "            confidentiality_level=ConfidentialityLevel[metadata.get('confidentiality', 'INTERNAL')],\n",
    "            author=metadata.get('author', 'Unknown'),\n",
    "            version=metadata.get('version', '1.0'),\n",
    "            created_date=datetime.fromisoformat(metadata.get('created_date', datetime.now().isoformat())),\n",
    "            modified_date=datetime.fromisoformat(metadata.get('modified_date', datetime.now().isoformat())),\n",
    "            timestamp=datetime.now(),\n",
    "            keywords=metadata.get('keywords', []),\n",
    "            business_process=metadata.get('business_process', ''),\n",
    "            language=language,\n",
    "            content_hash=content_hash,\n",
    "            file_size_bytes=len(content.encode())\n",
    "        )\n",
    "        \n",
    "        # Step 6: Chunk the document\n",
    "        chunks = self.chunk_text(content)\n",
    "        document_chunks = []\n",
    "        \n",
    "        for i, chunk_content in enumerate(chunks):\n",
    "            chunk_id = f\"{doc_id}_chunk_{i}\"\n",
    "            chunk = DocumentChunk(\n",
    "                chunk_id=chunk_id,\n",
    "                doc_id=doc_id,\n",
    "                parent_chunk_id=None,\n",
    "                content=chunk_content,\n",
    "                content_length=len(chunk_content),\n",
    "                chunk_index=i,\n",
    "                metadata=doc_metadata\n",
    "            )\n",
    "            document_chunks.append(chunk)\n",
    "        \n",
    "        return document_chunks\n",
    "\n",
    "print(\"✓ DocumentProcessor class created\")"
   ]
  }
