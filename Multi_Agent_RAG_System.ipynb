   "source": [
    "## 5.2: Generation Evaluation and Robustness Testing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class GenerationEvaluator:\n",
    "    \"\"\"\n",
    "    Evaluates quality of generated responses.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.evaluation_history = []\n",
    "    \n",
    "    def check_hallucination(self, response: str, context: str) -> Tuple[bool, float]:\n",
    "        \"\"\"\n",
    "        Check if response contains information not in context.\n",
    "        Returns: (is_hallucination, hallucination_score)\n",
    "        \"\"\"\n",
    "        response_words = set(response.lower().split())\n",
    "        context_words = set(context.lower().split())\n",
    "        \n",
    "        # Check overlap\n",
    "        overlap = len(response_words & context_words) / len(response_words) if response_words else 0\n",
    "        \n",
    "        is_hallucination = overlap < 0.5  # Less than 50% overlap suggests hallucination\n",
    "        hallucination_score = 1.0 - overlap\n",
    "        \n",
    "        return is_hallucination, hallucination_score\n",
    "    \n",
    "    def check_citation_accuracy(self, response: str, citations: List[str]) -> Tuple[float, List[str]]:\n",
    "        \"\"\"\n",
    "        Verify that cited sources are used in response.\n",
    "        Returns: (accuracy_score, unverified_citations)\n",
    "        \"\"\"\n",
    "        response_lower = response.lower()\n",
    "        verified_citations = 0\n",
    "        unverified = []\n",
    "        \n",
    "        for citation in citations:\n",
    "            citation_lower = citation.lower()\n",
    "            # Extract key terms from citation\n",
    "            keywords = [word for word in citation.split() if len(word) > 4]\n",
    "            if any(kw.lower() in response_lower for kw in keywords):\n",
    "                verified_citations += 1\n",
    "            else:\n",
    "                unverified.append(citation)\n",
    "        \n",
    "        accuracy = verified_citations / len(citations) if citations else 1.0\n",
    "        return accuracy, unverified\n",
    "    \n",
    "    def completeness_score(self, response_length: int) -> float:\n",
    "        \"\"\"\n",
    "        Score based on response length.\n",
    "        \"\"\"\n",
    "        # Target: 200-500 words for comprehensive answer\n",
    "        word_count = response_length // 5  # Approximate\n",
    "        \n",
    "        if word_count < 100:\n",
    "            return 0.3\n",
    "        elif word_count < 200:\n",
    "            return 0.6\n",
    "        elif word_count < 500:\n",
    "            return 1.0\n",
    "        else:\n",
    "            return 0.8  # Too verbose\n",
    "    \n",
    "    def evaluate_generation(self, response: str, context: str, citations: List[str]) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Comprehensive evaluation of generated response.\n",
    "        \"\"\"\n",
    "        is_hallucinating, hallucination_score = self.check_hallucination(response, context)\n",
    "        citation_accuracy, unverified = self.check_citation_accuracy(response, citations)\n",
    "        completeness = self.completeness_score(len(response))\n",
    "        \n",
    "        metrics = {\n",
    "            'hallucination_detected': is_hallucinating,\n",
    "            'hallucination_score': hallucination_score,\n",
    "            'citation_accuracy': citation_accuracy,\n",
    "            'unverified_citations': unverified,\n",
    "            'completeness_score': completeness,\n",
    "            'overall_quality': (1.0 - hallucination_score) * 0.4 + citation_accuracy * 0.4 + completeness * 0.2\n",
    "        }\n",
    "        \n",
    "        self.evaluation_history.append(metrics)\n",
    "        return metrics\n",
    "\n",
    "print(\"✓ GenerationEvaluator class created\")"
   ]
  },
