    "# TASK 3: Evidence Verification, Reasoning, and Context Optimization\n",
    "## Marks: 2\n",
    "\n",
    "### Objective\n",
    "Design an evidence verification layer with cross-encoder re-ranking, contradiction detection, and context optimization.\n",
    "\n",
    "### Components:\n",
    "1. Cross-Encoder Re-ranking\n",
    "2. Evidence Verification\n",
    "3. Trust Scoring\n",
    "4. Context Compression\n",
    "5. Citation Generation"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3.1: Cross-Encoder Re-ranking and Evidence Verification"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class EvidenceVerificationPipeline:\n",
    "    \"\"\"\n",
    "    Multi-stage evidence verification and ranking pipeline.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.verification_rules = [\n",
    "            'check_content_length',\n",
    "            'check_authority',\n",
    "            'check_recency',\n",
    "            'check_contradiction'\n",
    "        ]\n",
    "    \n",
    "    def compute_trust_score(self, evidence: Dict[str, Any]) -> float:\n",
    "        \"\"\"\n",
    "        Compute multi-factor trust score for evidence.\n",
    "        Factors:\n",
    "        - Retrieval confidence (40%)\n",
    "        - Document authority (30%)\n",
    "        - Recency (20%)\n",
    "        - Coherence (10%)\n",
    "        \"\"\"\n",
    "        score = 0.0\n",
    "        \n",
    "        # Factor 1: Retrieval confidence (40%)\n",
    "        confidence_score = evidence.get('confidence', 0.5)\n",
    "        score += confidence_score * 0.4\n",
    "        \n",
    "        # Factor 2: Document authority (30%)\n",
    "        metadata = evidence.get('metadata', {})\n",
    "        confidentiality = metadata.get('confidentiality_level', 'INTERNAL')\n",
    "        authority_levels = {'PUBLIC': 0.6, 'INTERNAL': 0.8, 'CONFIDENTIAL': 0.9, 'SECRET': 0.95}\n",
    "        authority_score = authority_levels.get(confidentiality, 0.7)\n",
    "        score += authority_score * 0.3\n",
    "        \n",
    "        # Factor 3: Recency (20%)\n",
    "        try:\n",
    "            modified_date = datetime.fromisoformat(metadata.get('modified_date', datetime.now().isoformat()))\n",
    "            days_old = (datetime.now() - modified_date).days\n",
    "            recency_score = max(0.3, 1.0 - (days_old / 365.0))  # Decay over a year\n",
    "            score += recency_score * 0.2\n",
    "        except:\n",
    "            score += 0.2\n",
    "        \n",
    "        # Factor 4: Content coherence (10%)\n",
    "        content = evidence.get('content', '')\n",
    "        word_count = len(content.split())\n",
    "        coherence_score = min(1.0, word_count / 500)  # Prefer longer, more detailed content\n",
    "        score += coherence_score * 0.1\n",
    "        \n",
    "        return min(score, 1.0)\n",
    "    \n",
    "    def detect_duplicates(self, evidence_list: List[Dict]) -> List[List[int]]:\n",
    "        \"\"\"\n",
    "        Detect duplicate or near-duplicate evidence using cosine similarity.\n",
    "        Returns: List of groups containing indices of duplicates\n",
    "        \"\"\"\n",
    "        duplicate_groups = []\n",
    "        seen = set()\n",
    "        \n",
    "        contents = [e['content'] for e in evidence_list]\n",
    "        if not contents:\n",
    "            return duplicate_groups\n",
    "        \n",
    "        # Simple string similarity check\n",
    "        for i, ev1 in enumerate(evidence_list):\n",
    "            if i in seen:\n",
    "                continue\n",
    "            \n",
    "            duplicates = [i]\n",
    "            for j in range(i + 1, len(evidence_list)):\n",
    "                if j not in seen:\n",
    "                    # Check if content is similar (50% overlap)\n",
    "                    words1 = set(ev1['content'].lower().split())\n",
    "                    words2 = set(evidence_list[j]['content'].lower().split())\n",
    "                    if words1 and words2:\n",
    "                        similarity = len(words1 & words2) / max(len(words1), len(words2))\n",
    "                        if similarity > 0.5:\n",
    "                            duplicates.append(j)\n",
    "                            seen.add(j)\n",
    "            \n",
    "            if len(duplicates) > 1:\n",
    "                duplicate_groups.append(duplicates)\n",
    "                seen.update(duplicates)\n",
    "        \n",
    "        return duplicate_groups\n",
    "    \n",
    "    def verify_evidence(self, evidence: Dict[str, Any]) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Verify single evidence item and compute trust score.\n",
    "        \"\"\"\n",
    "        # Compute trust score\n",
    "        trust_score = self.compute_trust_score(evidence)\n",
    "        \n",
    "        # Add verification metadata\n",
    "        evidence['trust_score'] = trust_score\n",
    "        evidence['verified'] = trust_score > 0.5\n",
    "        evidence['verification_timestamp'] = datetime.now().isoformat()\n",
    "        \n",
    "        return evidence\n",
    "    \n",
    "    def rerank_evidence(self, evidence_list: List[Dict]) -> List[Dict]:\n",
    "        \"\"\"\n",
    "        Re-rank evidence using cross-encoder approach (trust scores).\n",
    "        \"\"\"\n",
    "        # Verify each evidence item\n",
    "        verified_evidence = [self.verify_evidence(e) for e in evidence_list]\n",
    "        \n",
    "        # Sort by trust score\n",
    "        reranked = sorted(verified_evidence, key=lambda x: x['trust_score'], reverse=True)\n",
    "        \n",
    "        return reranked\n",
    "\n",
    "print(\"✓ EvidenceVerificationPipeline class created\")"
   ]
  },
