   "source": [
    "## 2.3: Task 2 - Agent Collaboration Demonstration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create specialized agents\n",
    "policy_agent = PolicyRetrievalAgent(hybrid_idx)\n",
    "tech_agent = TechnicalDocumentationAgent(hybrid_idx)\n",
    "incident_agent = IncidentAnalysisAgent(hybrid_idx)\n",
    "compliance_agent = ComplianceAgent(hybrid_idx)\n",
    "faq_agent = FAQAgent(hybrid_idx)\n",
    "\n",
    "# Create orchestrator\n",
    "orchestrator = MultiAgentOrchestrator([\n",
    "    policy_agent,\n",
