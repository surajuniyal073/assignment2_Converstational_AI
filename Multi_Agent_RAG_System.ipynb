    "## 3.2: Context Compression and Citation Generation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class ContextOptimizer:\n",
    "    \"\"\"\n",
    "    Optimizes context window construction under token limitations.\n",
    "    Implements context compression and citation generation.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, max_tokens: int = 4096, max_context_length: int = 3000):\n",
    "        self.max_tokens = max_tokens\n",
    "        self.max_context_length = max_context_length\n",
    "    \n",
    "    def estimate_tokens(self, text: str) -> int:\n",
    "        \"\"\"\n",
    "        Estimate token count (approximately 4 chars per token).\n",
    "        \"\"\"\n",
    "        return len(text) // 4\n",
    "    \n",
    "    def compress_content(self, content: str, compression_ratio: float = 0.7) -> str:\n",
    "        \"\"\"\n",
    "        Compress content by:\n",
    "        - Keeping first sentence of each paragraph\n",
    "        - Removing redundant information\n",
    "        \"\"\"\n",
    "        paragraphs = content.split('. ')\n",
    "        compressed = [p.split('. ')[0] for p in paragraphs[:int(len(paragraphs) * compression_ratio)]]\n",
    "        return '. '.join(compressed) + '.'\n",
    "    \n",
    "    def generate_citation(self, evidence: Dict[str, Any], citation_index: int) -> str:\n",
    "        \"\"\"\n",
    "        Generate proper citation for evidence.\n",
    "        Format: [N] Document: filename, Author: author, Department: department\n",
    "        \"\"\"\n",
    "        metadata = evidence.get('metadata', {})\n",
    "        filename = metadata.get('filename', 'Unknown')\n",
    "        author = metadata.get('author', 'Unknown')\n",
    "        department = metadata.get('department', 'Unknown')\n",
    "        \n",
    "        citation = f\"[{citation_index}] {filename} | Author: {author} | Department: {department}\"\n",
    "        return citation\n",
    "    \n",
    "    def build_context_window(self, evidence_list: List[Dict[str, Any]], query: str) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Build optimized context window with citations.\n",
    "        \"\"\"\n",
    "        # Sort by trust score\n",
    "        sorted_evidence = sorted(evidence_list, key=lambda x: x.get('trust_score', 0), reverse=True)\n",
    "        \n",
    "        context_parts = []\n",
    "        citations = []\n",
    "        total_length = self.estimate_tokens(query)  # Start with query tokens\n",
    "        included_count = 0\n",
    "        \n",
    "        for i, evidence in enumerate(sorted_evidence):\n",
    "            content = evidence['content']\n",
    "            content_tokens = self.estimate_tokens(content)\n",
    "            \n",
    "            # Check if we can fit this evidence\n",
    "            if total_length + content_tokens <= self.max_tokens - 500:  # Reserve 500 tokens for response\n",
    "                # Compress if needed\n",
    "                if total_length + content_tokens > self.max_context_length:\n",
    "                    content = self.compress_content(content)\n",
    "                    content_tokens = self.estimate_tokens(content)\n",
    "                \n",
    "                context_parts.append(content)\n",
    "                citations.append(self.generate_citation(evidence, i + 1))\n",
    "                total_length += content_tokens\n",
    "                included_count += 1\n",
    "            else:\n",
    "                break\n",
    "        \n",
    "        context_window = {\n",
    "            'query': query,\n",
    "            'context_content': '\\n---\\n'.join(context_parts),\n",
    "            'citations': citations,\n",
    "            'total_evidence_included': included_count,\n",
    "            'estimated_tokens': total_length,\n",
    "            'max_tokens_available': self.max_tokens,\n",
    "            'compression_used': any(len(p) < 200 for p in context_parts),\n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        }\n",
    "        \n",
    "        return context_window\n",
    "\n",
    "print(\"✓ ContextOptimizer class created\")"
   ]
  },
