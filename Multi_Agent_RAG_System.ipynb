   "source": [
    "## 5.1: Retrieval Evaluation Metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class RetrievalEvaluator:\n",
    "    \"\"\"\n",
    "    Evaluates retrieval performance using standard IR metrics.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.evaluation_history = []\n",
    "    \n",
    "    def recall_at_k(self, relevant_items: set, retrieved_items: List, k: int = 5) -> float:\n",
    "        \"\"\"\n",
    "        Recall@k = |relevant_items ∩ retrieved_items[:k]| / |relevant_items|\n",
    "        \"\"\"\n",
    "        if not relevant_items:\n",
    "            return 0.0\n",
    "        \n",
    "        retrieved_set = set(retrieved_items[:k])\n",
    "        matches = len(relevant_items & retrieved_set)\n",
    "        return matches / len(relevant_items)\n",
    "    \n",
    "    def precision_at_k(self, relevant_items: set, retrieved_items: List, k: int = 5) -> float:\n",
    "        \"\"\"\n",
    "        Precision@k = |relevant_items ∩ retrieved_items[:k]| / k\n",
    "        \"\"\"\n",
    "        if k == 0:\n",
    "            return 0.0\n",
    "        \n",
    "        retrieved_set = set(retrieved_items[:k])\n",
    "        matches = len(relevant_items & retrieved_set)\n",
    "        return matches / k\n",
    "    \n",
    "    def mean_reciprocal_rank(self, relevant_items: set, retrieved_items: List) -> float:\n",
    "        \"\"\"\n",
    "        MRR = 1/rank_of_first_relevant_item\n",
    "        \"\"\"\n",
    "        for rank, item in enumerate(retrieved_items, 1):\n",
    "            if item in relevant_items:\n",
    "                return 1.0 / rank\n",
    "        return 0.0\n",
    "    \n",
    "    def ndcg(self, relevance_scores: List[float], k: int = 5) -> float:\n",
    "        \"\"\"\n",
    "        Normalized Discounted Cumulative Gain\n",
    "        DCG@k = sum(rel_i / log2(i+1)) for i in 1..k\n",
    "        \"\"\"\n",
    "        if not relevance_scores:\n",
    "            return 0.0\n",
    "        \n",
    "        dcg = sum(score / np.log2(i + 2) for i, score in enumerate(relevance_scores[:k]))\n",
    "        ideal_dcg = sum(score / np.log2(i + 2) for i, score in enumerate(sorted(relevance_scores, reverse=True)[:k]))\n",
    "        \n",
    "        return dcg / ideal_dcg if ideal_dcg > 0 else 0.0\n",
    "    \n",
    "    def coverage(self, retrieved_docs: set, total_docs: set) -> float:\n",
    "        \"\"\"\n",
    "        Coverage = |retrieved_docs| / |total_docs|\n",
    "        \"\"\"\n",
    "        if not total_docs:\n",
    "            return 0.0\n",
    "        return len(retrieved_docs) / len(total_docs)\n",
    "    \n",
    "    def evaluate_retrieval(self, retrieved_scores: List[float], relevant_items: set) -> Dict[str, float]:\n",
    "        \"\"\"\n",
    "        Compute all retrieval metrics.\n",
    "        \"\"\"\n",
    "        retrieved_items = list(range(len(retrieved_scores)))\n",
    "        \n",
    "        metrics = {\n",
    "            'recall@5': self.recall_at_k(relevant_items, retrieved_items, k=5),\n",
    "            'recall@10': self.recall_at_k(relevant_items, retrieved_items, k=10),\n",
    "            'precision@5': self.precision_at_k(relevant_items, retrieved_items, k=5),\n",
    "            'precision@10': self.precision_at_k(relevant_items, retrieved_items, k=10),\n",
    "            'mrr': self.mean_reciprocal_rank(relevant_items, retrieved_items),\n",
    "            'ndcg@5': self.ndcg(retrieved_scores, k=5),\n",
    "            'ndcg@10': self.ndcg(retrieved_scores, k=10)\n",
    "        }\n",
    "        \n",
    "        self.evaluation_history.append(metrics)\n",
    "        return metrics\n",
    "\n",
    "print(\"✓ RetrievalEvaluator class created\")"
   ]
  },
