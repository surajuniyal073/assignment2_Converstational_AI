   "source": [
    "## 4.2: Adaptive Agent Planning and Execution"
   ]
  },
  {
   "cell_type": "code">
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class AdaptiveRetrievalSystem:\n",
    "    \"\"\"\n",
    "    Adaptive retrieval system with intelligent planning and failure handling.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, orchestrator: MultiAgentOrchestrator, verifier: EvidenceVerificationPipeline, \n",
    "                 optimizer: ContextOptimizer):\n",
    "        self.orchestrator = orchestrator\n",
    "        self.verifier = verifier\n",
    "        self.optimizer = optimizer\n",
    "        self.classifier = QueryClassifier()\n",
    "        self.decomposer = QueryDecomposer()\n",
    "        self.max_iterations = 3\n",
    "        self.execution_log = []\n",
    "    \n",
    "    def plan_retrieval(self, query_type: QueryType) -> List[str]:\n",
    "        \"\"\"\n",
    "        Plan retrieval strategy based on query type.\n",
    "        Returns: List of agent names to invoke\n",
    "        \"\"\"\n",
    "        strategy_map = {\n",
    "            QueryType.FACTUAL: ['Policy Retrieval Agent', 'Technical Documentation Agent'],\n",
    "            QueryType.ANALYTICAL: ['Technical Documentation Agent', 'Incident Analysis Agent'],\n",
    "            QueryType.COMPARATIVE: ['Technical Documentation Agent', 'Compliance Agent'],\n",
    "            QueryType.MULTI_HOP: ['Policy Retrieval Agent', 'Technical Documentation Agent', 'Incident Analysis Agent'],\n",
    "            QueryType.SUMMARIZATION: ['FAQ Agent', 'Technical Documentation Agent'],\n",
    "            QueryType.RECOMMENDATION: ['Compliance Agent', 'Policy Retrieval Agent']\n",
    "        }\n",
    "        \n",
    "        return strategy_map.get(query_type, ['Technical Documentation Agent'])\n",
    "    \n",
    "    def handle_failures(self, evidence_count: int, confidence_scores: List[float]) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Handle different failure scenarios.\n",
    "        \"\"\"\n",
    "        failure_report = {\n",
    "            'evidence_found': evidence_count > 0,\n",
    "            'high_confidence': any(s > 0.7 for s in confidence_scores),\n",
    "            'recovery_actions': []\n",
    "        }\n",
    "        \n",
    "        if evidence_count == 0:\n",
    "            failure_report['recovery_actions'].append('Query rewriting required')\n",
    "            failure_report['recovery_actions'].append('Expand search scope')\n",
    "        elif not failure_report['high_confidence']:\n",
    "            failure_report['recovery_actions'].append('Low confidence - request user clarification')\n",
    "            failure_report['recovery_actions'].append('Iterative retrieval with modified queries')\n",
    "        \n",
    "        return failure_report\n",
    "    \n",
    "    def adaptive_retrieve(self, query: str) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Main adaptive retrieval workflow.\n",
    "        \"\"\"\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"ADAPTIVE RETRIEVAL SYSTEM\")\n",
    "        print(f\"{'='*60}\")\n",
    "        \n",
    "        # Step 1: Classify query\n",
    "        query_type, class_confidence = self.classifier.classify(query)\n",
    "        print(f\"\\nQuery Classification: {query_type.value} (confidence: {class_confidence:.2f})\")\n",
    "        \n",
    "        # Step 2: Decompose complex queries\n",
    "        sub_queries = self.decomposer.decompose(query)\n",
    "        print(f\"Sub-queries: {len(sub_queries)}\")\n",
    "        for i, sq in enumerate(sub_queries, 1):\n",
    "            print(f\"  {i}. {sq}\")\n",
    "        \n",
    "        # Step 3: Plan retrieval strategy\n",
    "        planned_agents = self.plan_retrieval(query_type)\n",
    "        print(f\"\\nPlanned Agents: {planned_agents}\")\n",
    "        \n",
    "        # Step 4: Execute retrieval\n",
    "        all_evidence = []\n",
    "        for sq in sub_queries:\n",
    "            evidence = self.orchestrator.parallel_retrieval(sq, k=3)\n",
    "            all_evidence.extend(evidence)\n",
    "        \n",
    "        # Step 5: Verify evidence\n",
    "        verified_evidence = self.verifier.rerank_evidence(all_evidence)\n",
    "        \n",
    "        # Step 6: Handle failures\n",
    "        confidence_scores = [e.get('trust_score', 0.5) for e in verified_evidence]\n",
    "        failure_report = self.handle_failures(len(verified_evidence), confidence_scores)\n",
    "        \n",
    "        # Step 7: Build optimized context\n",
    "        context_window = self.optimizer.build_context_window(verified_evidence, query)\n",
    "        \n",
    "        result = {\n",
    "            'query': query,\n",
    "            'query_type': query_type.value,\n",
    "            'classification_confidence': class_confidence,\n",
    "            'sub_queries': sub_queries,\n",
    "            'planned_strategy': planned_agents,\n",
    "            'total_evidence': len(verified_evidence),\n",
    "            'avg_confidence': np.mean(confidence_scores) if confidence_scores else 0,\n",
    "            'failure_report': failure_report,\n",
    "            'context_window': context_window,\n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        }\n",
    "        \n",
    "        return result\n",
    "\n",
    "print(\"✓ AdaptiveRetrievalSystem class created\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
