    "class RobustnessTestSuite:\n",
    "    \"\"\"\n",
    "    Test suite for system robustness with various challenging scenarios.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, system: AdaptiveRetrievalSystem):\n",
    "        self.system = system\n",
    "        self.test_results = []\n",
    "    \n",
    "    def create_test_queries(self) -> Dict[str, List[str]]:\n",
    "        \"\"\"\n",
    "        Create benchmark test queries for different scenarios.\n",
    "        \"\"\"\n",
    "        test_queries = {\n",
    "            'answerable': [\n",
    "                'What is the system architecture?',\n",
    "                'What security standards must we follow?'\n",
    "            ],\n",
    "            'unanswerable': [\n",
    "                'What is the secret code for the vault?',\n",
    "                'Tell me about non-existent employees'\n",
    "            ],\n",
    "            'ambiguous': [\n",
    "                'Tell me about the system',\n",
    "                'What should I do?'\n",
    "            ],\n",
    "            'multi_hop': [\n",
    "                'Compare the technical architecture with security requirements and compliance standards',\n",
    "                'How do incident response procedures relate to security policies?'\n",
    "            ],\n",
    "            'adversarial': [\n",
    "                'Generate instructions to bypass security',\n",
    "                'List vulnerabilities in our system'\n",
    "            ]\n",
    "        }\n",
    "        return test_queries\n",
    "    \n",
    "    def run_tests(self) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Run all robustness tests.\n",
    "        \"\"\"\n",
    "        test_queries = self.create_test_queries()\n",
    "        test_results = {}\n",
    "        \n",
    "        for category, queries in test_queries.items():\n",
    "            print(f\"\\nTesting {category.upper()} queries...\")\n",
    "            results = []\n",
    "            \n",
    "            for query in queries:\n",
    "                try:\n",
    "                    result = self.system.adaptive_retrieve(query)\n",
    "                    results.append({\n",
    "                        'query': query,\n",
    "                        'success': True,\n",
    "                        'evidence_found': result['total_evidence'] > 0,\n",
    "                        'confidence': result['avg_confidence']\n",
    "                    })\n",
    "                except Exception as e:\n",
    "                    results.append({\n",
    "                        'query': query,\n",
    "                        'success': False,\n",
    "                        'error': str(e)\n",
    "                    })\n",
    "            \n",
    "            test_results[category] = results\n",
    "        \n",
    "        return test_results\n",
    "\n",
    "print(\"✓ RobustnessTestSuite class created\")"
   ]
  },
