    "class ProductionMonitor:\n",
    "    \"\"\"\n",
    "    Monitors system performance in production.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.metrics = defaultdict(list)\n",
    "        self.start_time = datetime.now()\n",
    "    \n",
    "    def record_query(self, query: str, processing_time: float, token_consumed: int,\n",
    "                     evidence_count: int, confidence: float, hallucination_detected: bool):\n",
    "        \"\"\"\n",
    "        Record a query execution.\n",
    "        \"\"\"\n",
    "        event = {\n",
    "            'timestamp': datetime.now().isoformat(),\n",
    "            'processing_time': processing_time,\n",
    "            'tokens': token_consumed,\n",
    "            'evidence_count': evidence_count,\n",
    "            'confidence': confidence,\n",
    "            'hallucination': hallucination_detected\n",
    "        }\n",
    "        \n",
    "        for key, value in event.items():\n",
    "            if key != 'timestamp':\n",
    "                self.metrics[key].append(value)\n",
    "    \n",
    "    def generate_dashboard(self) -> pd.DataFrame:\n",
    "        \"\"\"\n",
    "        Generate monitoring dashboard.\n",
    "        \"\"\"\n",
    "        if not self.metrics:\n",
    "            return pd.DataFrame()\n",
    "        \n",
    "        dashboard = pd.DataFrame({\n",
    "            'Metric': list(self.metrics.keys()),\n",
    "            'Average': [np.mean(v) if v else 0 for v in self.metrics.values()],\n",
    "            'Min': [min(v) if v else 0 for v in self.metrics.values()],\n",
    "            'Max': [max(v) if v else 0 for v in self.metrics.values()],\n",
    "            'Count': [len(v) for v in self.metrics.values()]\n",
    "        })\n",
    "        \n",
    "        return dashboard\n",
    "\n",
    "print(\"✓ ProductionMonitor class created\")"
   ]
  },
