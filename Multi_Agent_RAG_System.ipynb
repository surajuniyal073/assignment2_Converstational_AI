  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2.2: Agent Collaboration and Conflict Resolution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class MultiAgentOrchestrator:\n",
    "    \"\"\"\n",
    "    Orchestrates collaboration between multiple retrieval agents.\n",
    "    Handles conflict resolution and evidence unification.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, agents: List[RetrievalAgent]):\n",
    "        self.agents = agents\n",
    "        self.collaboration_log = []\n",
    "        \n",
    "    def parallel_retrieval(self, query: str, k: int = 5) -> List[Dict[str, Any]]:\n",
    "        \"\"\"\n",
    "        Execute retrieval in parallel from all agents.\n",
    "        Returns: Combined evidence from all agents\n",
    "        \"\"\"\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"PARALLEL RETRIEVAL - Query: '{query}'\")\n",
    "        print(f\"{'='*60}\")\n",
    "        \n",
    "        all_evidence = []\n",
    "        \n",
    "        # Collect evidence from all agents\n",
    "        for agent in self.agents:\n",
    "            print(f\"\\n[{agent.agent_name}] Retrieving...\")\n",
    "            evidence = agent.retrieve(query, k=k)\n",
    "            all_evidence.extend(evidence)\n",
    "            print(f\"  Retrieved {len(evidence)} results\")\n",
    "        \n",
    "        return all_evidence\n",
    "    \n",
    "    def detect_contradictions(self, evidence_list: List[Dict]) -> List[Tuple[Dict, Dict, str]]:\n",
    "        \"\"\"\n",
    "        Detect contradictory information from different sources.\n",
    "        Returns: List of (evidence1, evidence2, contradiction_description)\n",
    "        \"\"\"\n",
    "        contradictions = []\n",
    "        \n",
    "        # Simple contradiction detection based on keywords\n",
    "        keywords_yes = ['enabled', 'required', 'mandatory', 'must', 'approved']\n",
    "        keywords_no = ['disabled', 'optional', 'not required', 'should not', 'deprecated']\n",
    "        \n",
    "        for i, ev1 in enumerate(evidence_list):\n",
    "            for ev2 in evidence_list[i+1:]:\n",
    "                if ev1['chunk_id'] != ev2['chunk_id']:\n",
    "                    content1_lower = ev1['content'].lower()\n",
    "                    content2_lower = ev2['content'].lower()\n",
    "                    \n",
    "                    # Check for keyword contradictions\n",
    "                    has_yes_1 = any(kw in content1_lower for kw in keywords_yes)\n",
    "                    has_no_1 = any(kw in content1_lower for kw in keywords_no)\n",
    "                    has_yes_2 = any(kw in content2_lower for kw in keywords_yes)\n",
    "                    has_no_2 = any(kw in content2_lower for kw in keywords_no)\n",
    "                    \n",
    "                    if (has_yes_1 and has_no_2) or (has_no_1 and has_yes_2):\n",
    "                        contradictions.append((\n",
    "                            ev1,\n",
    "                            ev2,\n",
    "                            'Conflicting directives detected'\n",
    "                        ))\n",
    "        \n",
    "        return contradictions\n",
    "    \n",
    "    def resolve_conflicts(self, contradictions: List[Tuple]) -> List[Dict[str, Any]]:\n",
    "        \"\"\"\n",
    "        Resolve conflicts between contradictory evidence.\n",
    "        Resolution strategies:\n",
    "        1. Higher confidence wins\n",
    "        2. More recent document wins\n",
    "        3. Flag for manual review\n",
    "        \"\"\"\n",
    "        resolutions = []\n",
    "        \n",
    "        for ev1, ev2, reason in contradictions:\n",
    "            # Compare confidence scores\n",
    "            if ev1['confidence'] > ev2['confidence']:\n",
    "                winner = ev1\n",
    "                loser = ev2\n",
    "                strategy = 'Higher Confidence'\n",
    "            elif ev2['confidence'] > ev1['confidence']:\n",
    "                winner = ev2\n",
    "                loser = ev1\n",
    "                strategy = 'Higher Confidence'\n",
    "            else:\n",
    "                # If confidence is equal, compare timestamps\n",
    "                ts1 = datetime.fromisoformat(ev1['retrieval_timestamp'])\n",
    "                ts2 = datetime.fromisoformat(ev2['retrieval_timestamp'])\n",
    "                if ts1 > ts2:\n",
    "                    winner = ev1\n",
    "                    loser = ev2\n",
    "                    strategy = 'More Recent'\n",
    "                else:\n",
    "                    winner = ev2\n",
    "                    loser = ev1\n",
    "                    strategy = 'More Recent'\n",
    "            \n",
    "            resolution = {\n",
    "                'type': 'conflict_resolution',\n",
    "                'conflict': reason,\n",
    "                'resolution_strategy': strategy,\n",
    "                'winner': winner,\n",
    "                'loser': loser,\n",
    "                'winner_agent': winner['agent_name'],\n",
    "                'loser_agent': loser['agent_name']\n",
    "            }\n",
    "            resolutions.append(resolution)\n",
    "        \n",
    "        return resolutions\n",
    "    \n",
    "    def deduplicate_evidence(self, evidence_list: List[Dict]) -> List[Dict]:\n",
    "        \"\"\"\n",
    "        Remove duplicate evidence from multiple agents.\n",
    "        \"\"\"\n",
    "        seen = set()\n",
    "        deduplicated = []\n",
    "        \n",
    "        for evidence in evidence_list:\n",
    "            chunk_id = evidence['chunk_id']\n",
    "            if chunk_id not in seen:\n",
    "                seen.add(chunk_id)\n",
    "                deduplicated.append(evidence)\n",
    "        \n",
    "        return deduplicated\n",
    "    \n",
    "    def unify_evidence(self, evidence_list: List[Dict]) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Create unified candidate evidence set.\n",
    "        \"\"\"\n",
    "        # Deduplicate\n",
    "        deduplicated = self.deduplicate_evidence(evidence_list)\n",
    "        \n",
    "        # Detect contradictions\n",
    "        contradictions = self.detect_contradictions(deduplicated)\n",
    "        \n",
    "        # Resolve conflicts\n",
    "        resolutions = self.resolve_conflicts(contradictions) if contradictions else []\n",
    "        \n",
    "        # Rank by confidence\n",
    "        ranked_evidence = sorted(deduplicated, key=lambda x: x['confidence'], reverse=True)\n",
    "        \n",
    "        unified_set = {\n",
    "            'total_evidence_items': len(ranked_evidence),\n",
    "            'unique_agents': len(set(e['agent_id'] for e in ranked_evidence)),\n",
    "            'contradictions_detected': len(contradictions),\n",
    "            'contradictions': contradictions,\n",
    "            'resolutions': resolutions,\n",
    "            'unified_evidence': ranked_evidence,\n",
    "            'timestamp': datetime.now().isoformat()\n",
    "        }\n",
    "        \n",
    "        return unified_set\n",
    "    \n",
    "    def collaborative_retrieval(self, query: str, k: int = 5) -> Dict[str, Any]:\n",
    "        \"\"\"\n",
    "        Complete collaborative retrieval workflow.\n",
    "        \"\"\"\n",
    "        # Step 1: Parallel retrieval from all agents\n",
    "        all_evidence = self.parallel_retrieval(query, k)\n",
    "        \n",
    "        # Step 2: Unify evidence with conflict resolution\n",
    "        unified_result = self.unify_evidence(all_evidence)\n",
    "        \n",
    "        return unified_result\n",
    "\n",
    "print(\"✓ MultiAgentOrchestrator class created\")"
   ]
  },
