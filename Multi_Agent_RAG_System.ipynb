    "class KeywordIndex:\n",
    "    \"\"\"\n",
    "    Sparse Keyword Indexing using TF-IDF.\n",
    "    \n",
    "    Advantages:\n",
    "    - Fast indexing and retrieval\n",
    "    - Explainable (shows matching keywords)\n",
    "    - Low memory footprint\n",
    "    - Good for keyword-based queries\n",
    "    \n",
    "    Disadvantages:\n",
    "    - Doesn't capture semantic meaning\n",
    "    - Poor for synonyms\n",
    "    - Limited context understanding\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.vectorizer = TfidfVectorizer(max_features=5000, ngram_range=(1, 2))\n",
    "        self.chunks = []\n",
    "        self.tfidf_matrix = None\n",
    "        \n",
    "    def add_documents(self, chunks: List[DocumentChunk]):\n",
    "        \"\"\"\n",
    "        Build TF-IDF index for keyword search.\n",
    "        \"\"\"\n",
    "        print(f\"Building keyword index for {len(chunks)} chunks...\")\n",
    "        \n",
    "        texts = [chunk.content for chunk in chunks]\n",
    "        self.tfidf_matrix = self.vectorizer.fit_transform(texts)\n",
    "        self.chunks = chunks\n",
    "        \n",
    "        print(f\"✓ Keyword index built with {len(chunks)} chunks\")\n",
    "        print(f\"  Vocabulary size: {len(self.vectorizer.get_feature_names_out())}\")\n",
    "    \n",
    "    def search(self, query: str, k: int = 5) -> List[Tuple[DocumentChunk, float]]:\n",
    "        \"\"\"\n",
    "        Search for top-k documents by keyword matching.\n",
    "        \"\"\"\n",
    "        query_vector = self.vectorizer.transform([query])\n",
    "        similarities = cosine_similarity(query_vector, self.tfidf_matrix)[0]\n",
    "        \n",
    "        # Get top-k indices\n",
    "        top_indices = np.argsort(similarities)[::-1][:k]\n",
    "        \n",
    "        results = []\n",
    "        for idx in top_indices:\n",
    "            if similarities[idx] > 0:\n",
    "                results.append((self.chunks[idx], similarities[idx]))\n",
    "        \n",
    "        return results\n",
    "\n",
    "print(\"✓ KeywordIndex class created\")"
   ]
  },
