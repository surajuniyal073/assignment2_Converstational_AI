    "class HybridIndex:\n",
    "    \"\"\"\n",
    "    Hybrid Indexing combining Vector, Keyword, and Graph indices.\n",
    "    \n",
    "    Advantages:\n",
    "    - Combines strengths of all approaches\n",
    "    - Better coverage and ranking\n",
    "    - Handles diverse query types\n",
    "    \n",
    "    Disadvantages:\n",
    "    - Complex fusion logic needed\n",
    "    - Higher computational cost\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, model_name: str = 'all-MiniLM-L6-v2'):\n",
    "        self.vector_index = VectorIndex(model_name)\n",
    "        self.keyword_index = KeywordIndex()\n",
    "        self.graph_index = GraphIndex()\n",
    "        \n",
    "    def add_documents(self, chunks: List[DocumentChunk]):\n",
    "        \"\"\"\n",
    "        Add documents to all indices.\n",
    "        \"\"\"\n",
    "        print(\"Building hybrid index...\")\n",
    "        self.vector_index.add_documents(chunks)\n",
    "        self.keyword_index.add_documents(chunks)\n",
    "        self.graph_index.add_documents(chunks)\n",
    "        print(\"✓ Hybrid index built\")\n",
    "    \n",
    "    def reciprocal_rank_fusion(self, results_dict: Dict[str, List[Tuple]], k: int = 5) -> List[Tuple[DocumentChunk, float]]:\n",
    "        \"\"\"\n",
    "        Combine results from multiple indices using Reciprocal Rank Fusion.\n",
    "        Formula: RRF(d) = sum(1 / (k + rank_i(d)))\n",
    "        \"\"\"\n",
    "        fusion_scores = defaultdict(float)\n",
    "        \n",
    "        for source_name, results in results_dict.items():\n",
    "            for rank, (chunk, score) in enumerate(results):\n",
    "                fusion_scores[chunk.chunk_id] += 1 / (60 + rank + 1)\n",
    "        \n",
    "        # Sort by fusion score\n",
    "        sorted_ids = sorted(fusion_scores.items(), key=lambda x: x[1], reverse=True)[:k]\n",
    "        \n",
    "        # Map back to chunks\n",
    "        chunk_map = {chunk.chunk_id: chunk for chunk in self.vector_index.chunks}\n",
    "        results = [(chunk_map[chunk_id], score) for chunk_id, score in sorted_ids if chunk_id in chunk_map]\n",
    "        \n",
    "        return results\n",
    "    \n",
    "    def search(self, query: str, k: int = 5) -> List[Tuple[DocumentChunk, float]]:\n",
    "        \"\"\"\n",
    "        Perform hybrid search combining all indices.\n",
    "        \"\"\"\n",
    "        # Get results from all indices\n",
    "        vector_results = self.vector_index.search(query, k)\n",
    "        keyword_results = self.keyword_index.search(query, k)\n",
    "        graph_results = self.graph_index.search(query, k)\n",
    "        \n",
    "        # Combine using RRF\n",
    "        combined_results = self.reciprocal_rank_fusion(\n",
    "            {\n",
    "                'vector': vector_results,\n",
    "                'keyword': keyword_results,\n",
    "                'graph': graph_results\n",
    "            },\n",
    "            k\n",
    "        )\n",
    "        \n",
    "        return combined_results\n",
    "\n",
    "print(\"✓ HybridIndex class created\")"
   ]
  }
 ],
