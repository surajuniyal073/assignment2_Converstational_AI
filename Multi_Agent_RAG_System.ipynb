    "# TASK 4: Intelligent Agent Planning and Adaptive Retrieval\n",
    "## Marks: 2\n",
    "\n",
    "### Objective\n",
    "Extend the architecture into an adaptive multi-agent reasoning system with query classification and planning.\n",
    "\n",
    "### Components:\n",
    "1. Query Classification\n",
    "2. Query Decomposition\n",
    "3. Adaptive Agent Planning\n",
    "4. Iterative Retrieval and Failure Handling"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4.1: Query Classification and Decomposition"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class QueryType(Enum):\n",
    "    FACTUAL = \"FACTUAL\"\n",
    "    ANALYTICAL = \"ANALYTICAL\"\n",
    "    COMPARATIVE = \"COMPARATIVE\"\n",
    "    MULTI_HOP = \"MULTI_HOP\"\n",
    "    SUMMARIZATION = \"SUMMARIZATION\"\n",
    "    RECOMMENDATION = \"RECOMMENDATION\"\n",
    "\n",
    "class QueryClassifier:\n",
    "    \"\"\"\n",
    "    Classifies queries into types to determine optimal retrieval strategy.\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.query_patterns = {\n",
    "            QueryType.FACTUAL: [r'what is', r'who is', r'when', r'where', r'how many'],\n",
    "            QueryType.ANALYTICAL: [r'why', r'explain', r'analyze', r'describe', r'how does'],\n",
    "            QueryType.COMPARATIVE: [r'compare', r'difference', r'vs', r'versus', r'better'],\n",
    "            QueryType.MULTI_HOP: [r'and', r'also', r'then', r'furthermore', r'relationship'],\n",
    "            QueryType.SUMMARIZATION: [r'summary', r'overview', r'brief', r'outline', r'list'],\n",
    "            QueryType.RECOMMENDATION: [r'recommend', r'suggest', r'best practice', r'should', r'advice']\n",
    "        }\n",
    "    \n",
    "    def classify(self, query: str) -> Tuple[QueryType, float]:\n",
    "        \"\"\"\n",
    "        Classify query and return confidence score.\n",
    "        Returns: (QueryType, confidence_score)\n",
    "        \"\"\"\n",
    "        query_lower = query.lower()\n",
    "        scores = {}\n",
    "        \n",
    "        for query_type, patterns in self.query_patterns.items():\n",
    "            matches = sum(1 for pattern in patterns if re.search(pattern, query_lower))\n",
    "            scores[query_type] = matches\n",
    "        \n",
    "        if max(scores.values()) == 0:\n",
    "            return QueryType.FACTUAL, 0.5  # Default to factual\n",
    "        \n",
    "        best_type = max(scores, key=scores.get)\n",
    "        confidence = scores[best_type] / sum(len(patterns) for patterns in self.query_patterns.values())\n",
    "        \n",
    "        return best_type, min(confidence, 1.0)\n",
    "\n",
    "class QueryDecomposer:\n",
    "    \"\"\"\n",
    "    Decomposes complex queries into simpler sub-queries.\n",
    "    \"\"\"\n",
    "    \n",
    "    def decompose(self, query: str) -> List[str]:\n",
    "        \"\"\"\n",
    "        Decompose query into sub-queries.\n",
    "        \"\"\"\n",
    "        sub_queries = []\n",
    "        \n",
    "        # Split by 'and' or 'also'\n",
    "        if ' and ' in query.lower():\n",
    "            parts = query.split(' and ')\n",
    "            sub_queries.extend(parts)\n",
    "        elif ' also ' in query.lower():\n",
    "            parts = query.split(' also ')\n",
    "            sub_queries.extend(parts)\n",
    "        else:\n",
    "            # Single query\n",
    "            sub_queries = [query]\n",
    "        \n",
    "        return [q.strip() for q in sub_queries if q.strip()]\n",
    "\n",
    "print(\"✓ Query Classification and Decomposition classes created\")"
   ]
  },
