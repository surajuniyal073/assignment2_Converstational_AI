    "class GraphIndex:\n",
    "    \"\"\"\n",
    "    Knowledge Graph Indexing.\n",
    "    Creates relationships between documents and concepts.\n",
    "    \n",
    "    Advantages:\n",
    "    - Captures semantic relationships\n",
    "    - Supports entity-based queries\n",
    "    - Enables traversal-based retrieval\n",
    "    - Good for complex reasoning\n",
    "    \n",
    "    Disadvantages:\n",
    "    - Requires entity extraction\n",
    "    - More complex to maintain\n",
    "    - Scalability challenges\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.graph = nx.DiGraph()\n",
    "        self.chunks = []\n",
    "        self.entity_map = {}  # entity -> [chunk_ids]\n",
    "        \n",
    "    def extract_entities(self, text: str) -> List[str]:\n",
    "        \"\"\"\n",
    "        Simple entity extraction using regex patterns.\n",
    "        In production, use NER (Named Entity Recognition) models.\n",
    "        \"\"\"\n",
    "        entities = []\n",
    "        # Extract capitalized phrases (potential entities)\n",
    "        matches = re.findall(r'\\b[A-Z][a-z]+(?:\\s[A-Z][a-z]+)*\\b', text)\n",
    "        return list(set(matches))[:10]  # Limit to 10 entities per chunk\n",
    "    \n",
    "    def add_documents(self, chunks: List[DocumentChunk]):\n",
    "        \"\"\"\n",
    "        Build knowledge graph from documents.\n",
    "        \"\"\"\n",
    "        print(f\"Building graph index for {len(chunks)} chunks...\")\n",
    "        \n",
    "        for chunk in chunks:\n",
    "            # Add chunk node\n",
    "            self.graph.add_node(chunk.chunk_id, type='chunk', content=chunk.content[:100])\n",
    "            \n",
    "            # Extract and add entities\n",
    "            entities = self.extract_entities(chunk.content)\n",
    "            for entity in entities:\n",
    "                self.graph.add_node(entity, type='entity')\n",
    "                self.graph.add_edge(entity, chunk.chunk_id, relation='mentioned_in')\n",
    "                self.graph.add_edge(chunk.chunk_id, entity, relation='contains')\n",
    "                \n",
    "                if entity not in self.entity_map:\n",
    "                    self.entity_map[entity] = []\n",
    "                self.entity_map[entity].append(chunk.chunk_id)\n",
    "            \n",
    "            # Add document relationship\n",
    "            if chunk.doc_id not in self.graph:\n",
    "                self.graph.add_node(chunk.doc_id, type='document')\n",
    "            self.graph.add_edge(chunk.doc_id, chunk.chunk_id, relation='contains')\n",
    "        \n",
    "        self.chunks = chunks\n",
    "        print(f\"✓ Graph index built with {self.graph.number_of_nodes()} nodes and {self.graph.number_of_edges()} edges\")\n",
    "    \n",
    "    def search(self, query: str, k: int = 5) -> List[Tuple[DocumentChunk, float]]:\n",
    "        \"\"\"\n",
    "        Search using entity-based graph traversal.\n",
    "        \"\"\"\n",
    "        query_entities = self.extract_entities(query)\n",
    "        candidate_chunks = set()\n",
    "        \n",
    "        for entity in query_entities:\n",
    "            if entity in self.entity_map:\n",
    "                candidate_chunks.update(self.entity_map[entity])\n",
    "        \n",
    "        # Get the corresponding chunks\n",
    "        chunk_map = {chunk.chunk_id: chunk for chunk in self.chunks}\n",
    "        results = [(chunk_map[cid], 0.8) for cid in list(candidate_chunks)[:k] if cid in chunk_map]\n",
    "        \n",
    "        return results\n",
    "\n",
    "print(\"✓ GraphIndex class created\")"
   ]
  },
